    {
      "name": "00 준비 - A/B 회원가입",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.info.requestName === '회원가입 A') { const s=pm.variables.replaceIn('{{$guid}}').replace(/-/g,'').slice(0,8); pm.collectionVariables.set('emailA','a'+s+'@example.com'); pm.collectionVariables.set('emailB','b'+s+'@example.com'); pm.collectionVariables.set('nicknameA','A'+s); pm.collectionVariables.set('nicknameB','B'+s); pm.collectionVariables.set('tokenA',''); pm.collectionVariables.set('tokenB',''); }"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "회원가입 A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/members",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "members"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailA}}\",\n  \"nickname\": \"{{nicknameA}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
                  "pm.test('COMMON201',()=>pm.expect(pm.response.json().code).to.eql('COMMON201'));",
                  "pm.collectionVariables.set('memberA',pm.response.json().result.memberId);"
                ]
              }
            }
          ]
        },
        {
          "name": "회원가입 B",
