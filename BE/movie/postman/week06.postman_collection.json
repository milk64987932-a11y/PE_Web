{
  "info": {
    "name": "UMC BE week06",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order. Signup and rating IDs are captured automatically. Change email/nickname for another run."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "email",
      "value": "umc-week06@example.com"
    },
    {
      "key": "nickname",
      "value": "week06fan"
    },
    {
      "key": "memberId",
      "value": ""
    },
    {
      "key": "ratingId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Sign up",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/members",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"Umc!1234\",\n  \"nickname\": \"{{nickname}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "if(pm.response.code===201) pm.collectionVariables.set('memberId',pm.response.json().result.memberId);"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "Expected response",
          "status": "Example",
          "code": 201,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"isSuccess\": true,\n  \"code\": \"COMMON201\",\n  \"message\": \"회원가입에 성공했습니다.\",\n  \"result\": {\n    \"memberId\": 1,\n    \"email\": \"umc@example.com\",\n    \"nickname\": \"moviefan\"\n  }\n}"
        }
      ]
    },
    {
      "name": "Create rating",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/members/{{memberId}}/ratings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"movieId\": 550,\n  \"score\": 5,\n  \"comment\": \"좋은 영화\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "if(pm.response.code===201) pm.collectionVariables.set('ratingId',pm.response.json().result);"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "Expected response",
          "status": "Example",
          "code": 201,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"isSuccess\": true,\n  \"code\": \"COMMON201\",\n  \"message\": \"평점 등록에 성공했습니다.\",\n  \"result\": 1\n}"
        }
      ]
    },
    {
      "name": "Update rating",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/members/{{memberId}}/ratings/{{ratingId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"score\": 4,\n  \"comment\": \"다시 본 후기\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "Expected response",
          "status": "Example",
          "code": 200,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"isSuccess\": true,\n  \"code\": \"COMMON200\",\n  \"message\": \"평점 수정에 성공했습니다.\",\n  \"result\": null\n}"
        }
      ]
    },
    {
      "name": "Get ratings",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/members/{{memberId}}/ratings"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "Expected response",
          "status": "Example",
          "code": 200,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "[]"
        }
      ]
    },
    {
      "name": "Delete rating",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/members/{{memberId}}/ratings/{{ratingId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "Expected response",
          "status": "No Content",
          "code": 204,
          "header": [],
          "body": ""
        }
      ]
    },
    {
      "name": "Duplicate email",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/members",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"Umc!1234\",\n  \"nickname\": \"othername\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 409', () => pm.response.to.have.status(409));"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "Expected response",
          "status": "Example",
          "code": 409,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"isSuccess\": false,\n  \"code\": \"MEMBER4091\",\n  \"message\": \"이미 사용 중인 이메일입니다.\",\n  \"result\": null\n}"
        }
      ]
    },
    {
      "name": "Invalid score",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/members/{{memberId}}/ratings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"movieId\": 550,\n  \"score\": 6\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "Expected response",
          "status": "Example",
          "code": 400,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"isSuccess\": false,\n  \"code\": \"COMMON400\",\n  \"message\": \"입력 값의 형식과 범위를 확인해 주세요.\",\n  \"result\": null\n}"
        }
      ]
    }
  ]
}